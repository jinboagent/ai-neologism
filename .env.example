# AI provider — any OpenAI-compatible chat-completions endpoint works.
# Without AI_API_KEY the "Coin with AI" tab degrades gracefully; the manual form still works.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Database — leave empty for local development (a file at data/ai-neologism.db).
# For production on Vercel: create a free Turso database (turso.tech) and fill in
# the two values it gives you. Real credentials belong in .env.local or the Vercel
# dashboard — NEVER in this file, which is committed to the public repository.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Web search used for novelty verification.
# Default: keyless DuckDuckGo HTML (best-effort). Optional: Tavily.
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=

# Review rights unlock after this many accepted words per contribution key.
REVIEW_THRESHOLD=3

# Set to true when the app runs behind a platform that sets the real client IP
# in X-Forwarded-For (e.g. Vercel). Leave unset/false for local development —
# client-supplied proxy headers are otherwise ignored for rate limiting and
# vote de-duplication.
# TRUST_PROXY=true

# Daily auto-coiner (triggered by Vercel Cron or any scheduler calling
# /api/cron/coin). Vercel sends CRON_SECRET automatically as a Bearer header
# when this env var is set on the platform. Number of words per run (1-10).
AUTO_COIN_COUNT=5
CRON_SECRET=

# Admin account for /admin (the background gate for third-party API submissions).
# API submissions are reviewed by this account alone; browser submissions use the
# community review ladder. Set these on the platform; never commit real values.
# ADMIN_SECRET (optional, random hex) is the dedicated admin-session signing key;
# when set it decouples "rotate the password" from "invalidate all sessions".
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_SECRET=

# Hard daily ceiling on /api/coin/candidates calls across ALL visitors — bounds
# worst-case paid-AI spend if the per-identity limiter is parallelized around
# (a botnet of fresh fingerprints). Default 100 when unset.
# COIN_DAILY_CAP=100

# Rejection notifications for API submitters (optional contact_email they provide).
# Resend free tier: ~100 emails/day. Without a key, rejections are recorded but not emailed.
RESEND_API_KEY=
MAIL_FROM=AI Neologism <onboarding@resend.dev>
